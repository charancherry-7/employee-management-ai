# Workspace + auth (prefer a service principal / OAuth M2M in production
# over a personal access token)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<service-principal-or-pat-token>

# SQL warehouse the pipeline SQL runs against (Serverless SQL warehouse
# required for ai_classify / ai_extract)
DATABRICKS_WAREHOUSE_ID=<warehouse-id>

# Unity Catalog location set up by sql/01_bronze_volumes.sql
UC_CATALOG=employee_mgmt
UC_SCHEMA=doc_intelligence

# Genie Space set up per sql/04_genie_setup.md
GENIE_SPACE_ID=<genie-space-id>

# Foundation Model Serving endpoint used by ai_query() for the
# comparison summary
FOUNDATION_MODEL_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
